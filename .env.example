# ===== App =====
PROJECT_NAME="Ruang Kita API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Format JSON array
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ===== Database (MySQL) =====
# Driver aiomysql — sesuaikan user/password/port/nama db
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/ruang_kita_db

# ===== Security / JWT =====
# WAJIB diganti di production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== AI Providers (fase berikutnya) =====
GEMINI_API_KEY=
GROQ_API_KEY=

# ===== AI Gateway (OpenRouter) =====
# Dapatkan key gratis di https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=90

# Model tier gratis (akhiran :free). Default dipanggil duluan,
# fallback dicoba berurutan saat rate limit / error.
# Cek ketersediaan terbaru: GET https://openrouter.ai/api/v1/models
AI_MODEL_DEFAULT=meta-llama/llama-3.3-70b-instruct:free
AI_MODEL_FALLBACKS=["google/gemini-2.0-flash-exp:free","qwen/qwen-2.5-72b-instruct:free","deepseek/deepseek-chat-v3-0324:free"]

# ===== Logging =====
# File log harian: logs/app.log (rotasi tengah malam). DEBUG untuk lebih detail.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# ===== Admin (ensiklopedia) =====
# Email yang boleh mengelola konten topik via /api/v1/admin/topics.
# Kosong = belum ada admin. Format JSON array.
ADMIN_EMAILS=[]

# ===== Importer konten massal (scripts/import_topics_bulk.py) =====
# Akun admin (email harus terdaftar di ADMIN_EMAILS) yang dipakai skrip impor
# massal untuk login lalu POST /admin/topics. Jangan commit nilai aslinya.
IMPORT_ADMIN_EMAIL=
IMPORT_ADMIN_PASSWORD=

# ===== RAG semantik (opsional) =====
# Isi key GRATIS dari https://aistudio.google.com/apikey untuk mengaktifkan
# retrieval semantik (menangkap parafrase tanpa kata kunci persis).
# Tanpa key: sistem otomatis memakai retrieval leksikal saja.
GEMINI_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_SIMILARITY_THRESHOLD=0.55
RAG_SEMANTIC_ENABLED=true
